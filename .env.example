# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=domino
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=domino

# Used to sign session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-value

# Number of reverse proxies in front of the app, so it trusts the right client
# IP for login rate limiting and HTTPS detection. Use 1 for nginx-only or
# Cloudflare-Tunnel-only; use 2 for Cloudflare Tunnel -> nginx -> app. Default 1.
# TRUST_PROXY_HOPS=1
