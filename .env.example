# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=domino
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=domino

# Used to sign session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-value

# LAN IP of this Docker host that your nginx LXC can reach. Do NOT use 0.0.0.0 -
# that would expose the app on every interface, including any public one.
APP_BIND_ADDRESS=192.168.1.50
